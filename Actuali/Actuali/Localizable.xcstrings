    "Touch and hold a budget for options to remove it from this device or delete it from the server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold a budget for options to remove it from this device or delete it from the server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez de manière prolongée sur un budget pour obtenir des options permettant de le supprimer de cet appareil ou du serveur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque y mantenga pulsado un presupuesto para ver opciones para eliminarlo de este dispositivo o del servidor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure um orçamento para ver opções de removê-lo deste dispositivo ou excluí-lo do servidor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berühren und halten Sie ein Budget für Optionen, um es von diesem Gerät zu entfernen oder vom Server zu löschen."
          }
        },
        "it": {
          "stringUnit": {
