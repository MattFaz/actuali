    "Creates a budget account for %@ at %@ and links it. Its opening balance is worked out on the first sync.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a budget account for %@ at %@ and links it. Its opening balance is worked out on the first sync."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un compte budgétaire pour %@ chez %@ et le lie. Son solde initial est calculé lors de la première synchronisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una cuenta presupuestaria para %@ en %@ y la vincula. Su saldo inicial se calcula en la primera sincronización."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria uma conta de orçamento para %@ em %@ e a vincula. O saldo inicial é calculado na primeira sincronização."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt ein Budgetkonto für %@ bei %@ und verknüpft es. Der Eröffnungssaldo wird bei der ersten Synchronisierung berechnet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un conto budget per %@ presso %@ e lo collega. Il saldo iniziale viene calcolato alla prima sincronizzazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt een budgetrekening voor %@ bij %@ en koppelt deze. Het beginsaldo wordt bij de eerste synchronisatie berekend."
          }
        }
      }
    },
