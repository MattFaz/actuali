    "Mark accounts as credit cards and track their monthly billing cycles, cycle spend, and upcoming payment due dates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markieren Sie Konten als Kreditkarten und verfolgen Sie deren monatliche Abrechnungszyklen, Ausgaben pro Zyklus und anstehende Zahlungstermine."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark accounts as credit cards and track their monthly billing cycles, cycle spend, and upcoming payment due dates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque cuentas como tarjetas de crédito y controle sus ciclos de facturación mensuales, el gasto del ciclo y las próximas fechas de vencimiento de pago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquez des comptes comme cartes de crédit et suivez leurs cycles de facturation mensuels, les dépenses du cycle et les prochaines échéances de paiement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrassegna i conti come carte di credito e monitora i loro cicli di fatturazione mensili, la spesa del ciclo e le prossime scadenze di pagamento."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markeer rekeningen als creditcards en volg hun maandelijkse factureringscycli, uitgaven per cyclus en aankomende betaaldata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque contas como cartões de crédito e acompanhe seus ciclos de faturamento mensais, gastos do ciclo e próximas datas de vencimento."
          }
        }
      }
    },
