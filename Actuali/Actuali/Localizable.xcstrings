            "state": "translated",
            "value": "SimpleFIN returned an unexpected response (HTTP %lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN a renvoyé une réponse inattendue (HTTP %lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN devolvió una respuesta inesperada (HTTP %lld)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SimpleFIN retornou uma resposta inesperada (HTTP %lld)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN hat eine unerwartete Antwort zurückgegeben (HTTP %lld)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN ha restituito una risposta imprevista (HTTP %lld)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN gaf een onverwacht antwoord terug (HTTP %lld)."
          }
        }
      }
    },
    "That doesn't look like a SimpleFIN setup token. Copy the whole token from SimpleFIN and paste it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like a SimpleFIN setup token. Copy the whole token from SimpleFIN and paste it again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne ressemble pas à un jeton de configuration SimpleFIN. Copiez le jeton complet depuis SimpleFIN et collez-le à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no parece un token de configuración de SimpleFIN. Copia el token completo de SimpleFIN y vuelve a pegarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não parece um token de configuração do SimpleFIN. Copie o token inteiro do SimpleFIN e cole-o novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nicht wie ein SimpleFIN-Einrichtungstoken aus. Kopiere das vollständige Token von SimpleFIN und füge es erneut ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo non sembra un token di configurazione SimpleFIN. Copia il token completo da SimpleFIN e incollalo di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit lijkt geen SimpleFIN-insteltoken te zijn. Kopieer het volledige token van SimpleFIN en plak het opnieuw."
          }
        }
      }
    },
    "The stored SimpleFIN access key is unreadable. Disconnect SimpleFIN and set it up again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stored SimpleFIN access key is unreadable. Disconnect SimpleFIN and set it up again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé d’accès SimpleFIN enregistrée est illisible. Déconnectez SimpleFIN et configurez-le à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de acceso de SimpleFIN guardada no se puede leer. Desconecta SimpleFIN y configúralo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a chave de acesso salva do SimpleFIN. Desconecte o SimpleFIN e configure-o novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte SimpleFIN-Zugriffsschlüssel ist nicht lesbar. Trenne SimpleFIN und richte es erneut ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di accesso SimpleFIN salvata non è leggibile. Disconnetti SimpleFIN e configuralo di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgeslagen SimpleFIN-toegangssleutel kan niet worden gelezen. Koppel SimpleFIN los en stel het opnieuw in."
          }
        }
      }
    },
