    "Suggestions use this category's existing Actual history and replace the amount shown above.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestions use this category's existing Actual history and replace the amount shown above."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suggestions utilisent l'historique Actual existant de cette catégorie et remplacent le montant affiché ci-dessus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias utilizan el historial existente de esta categoría en Actual y sustituyen el importe mostrado arriba."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sugestões usam o histórico existente do Actual desta categoria e substituem o valor mostrado acima."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge verwenden den vorhandenen Actual-Verlauf dieser Kategorie und ersetzen den oben angezeigten Betrag."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suggerimenti utilizzano la cronologia Actual esistente di questa categoria e sostituiscono l'importo mostrato sopra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggesties gebruiken de bestaande Actual-geschiedenis van deze categorie en vervangen het hierboven getoonde bedrag."
          }
        }
      }
    },
