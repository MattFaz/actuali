    "reconcile.lockCleared": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock Cleared Transactions"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouiller les transactions pointées"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
