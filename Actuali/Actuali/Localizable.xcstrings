          }
        }
      }
    },
    "This permanently deletes «%@» from your Actual server for every device that uses it, along with this device's copy and its local backups. This cannot be undone.\n\nType the budget's name to confirm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes «%@» from your Actual server for every device that uses it, along with this device's copy and its local backups. This cannot be undone.\n\nType the budget's name to confirm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement « %@ » de votre serveur Actual. Cette action est irréversible.\n\nSaisissez le nom du budget pour confirmer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente « %@ » de tu servidor Actual. No se puede deshacer.\n\nEscribe el nombre del presupuesto para confirmar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui permanentemente “%@” do servidor Actual. Não é possível desfazer.\n\nDigite o nome do orçamento para confirmar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht „%@“ dauerhaft vom Actual-Server. Dies kann nicht rückgängig gemacht werden.\n\nGib den Budgetnamen zur Bestätigung ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente «%@» dal server Actual. Non puoi annullare questa azione.\n\nInserisci il nome del budget per confermare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert «%@» definitief van je Actual-server. Dit kan niet ongedaan worden gemaakt.\n\nTyp de budgetnaam om te bevestigen."
          }
        }
      }
    },
