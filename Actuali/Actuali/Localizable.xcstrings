    "A weekly or daily cap is multiplied by the number of weeks or days in the month, so the effective monthly cap changes with each month." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine wöchentliche oder tägliche Obergrenze wird mit der Anzahl der Wochen bzw. Tage im Monat multipliziert, sodass sich die effektive monatliche Obergrenze von Monat zu Monat ändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A weekly or daily cap is multiplied by the number of weeks or days in the month, so the effective monthly cap changes with each month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un límite semanal o diario se multiplica por el número de semanas o días del mes, por lo que el límite mensual efectivo cambia cada mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un plafond hebdomadaire ou quotidien est multiplié par le nombre de semaines ou de jours du mois, de sorte que le plafond mensuel effectif change chaque mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un limite settimanale o giornaliero viene moltiplicato per il numero di settimane o giorni del mese, quindi il limite mensile effettivo cambia ogni mese."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een wekelijkse of dagelijkse limiet wordt vermenigvuldigd met het aantal weken of dagen in de maand, waardoor de effectieve maandelijkse limiet elke maand verandert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um limite semanal ou diário é multiplicado pelo número de semanas ou dias no mês, portanto o limite mensal efetivo muda a cada mês."
          }
        }
      }
    },
