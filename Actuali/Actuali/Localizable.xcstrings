    "Categories splitting the remainder receive it proportionally to their weights.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories splitting the remainder receive it proportionally to their weights."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories qui se partagent le reste le reçoivent proportionnellement à leur poids."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las categorías que se reparten el resto lo reciben proporcionalmente a su peso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias que dividem o restante o recebem proporcionalmente aos seus pesos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorien, die sich den Rest teilen, erhalten ihn proportional zu ihrer Gewichtung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le categorie che si dividono il resto lo ricevono in proporzione al loro peso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorieën die de rest verdelen, ontvangen deze naar verhouding van hun gewicht."
          }
        }
      }
    },
