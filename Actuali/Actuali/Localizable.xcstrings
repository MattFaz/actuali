    "I confirm that the numeric amount is in the active budget currency (%@); no conversion from %@ will be performed." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bestätige, dass der numerische Betrag in der Währung des aktiven Budgets (%@) angegeben ist; es wird keine Umrechnung von %@ vorgenommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I confirm that the numeric amount is in the active budget currency (%@); no conversion from %@ will be performed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmo que el importe numérico está en la divisa del presupuesto activo (%@); no se realizará ninguna conversión desde %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je confirme que le montant numérique est dans la devise du budget actif (%@) ; aucune conversion depuis %@ ne sera effectuée."
          }
