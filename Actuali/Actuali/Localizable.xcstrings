            "state": "translated",
            "value": "Escolha Criar Novo Atalho."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie „Neue Verknüpfung erstellen“."
          }
        },
        "it": {
          "stringUnit": {
