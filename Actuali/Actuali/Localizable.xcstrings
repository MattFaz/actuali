          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suggestions utilisent l'historique Actual existant de cette catégorie et remplacent le montant du mois en cours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias usan el historial existente de Actual de esta categoría y reemplazan el importe del mes actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sugestões usam o histórico existente do Actual para esta categoria e substituem o valor do mês atual."
