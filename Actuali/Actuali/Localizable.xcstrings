    "New transaction alerts require Background App Refresh. Credit card due reminders are sent 7, 5, 3, and 1 days before payment is due for cards with an unpaid balance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Transaktionswarnungen benötigen Hintergrundaktualisierung. Kreditkarten-Fälligkeitserinnerungen werden für Karten mit offenem Saldo 7, 5, 3 und 1 Tage vor dem Zahlungstermin gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New transaction alerts require Background App Refresh. Credit card due reminders are sent 7, 5, 3, and 1 days before payment is due for cards with an unpaid balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alertas de nuevas transacciones requieren actualización en segundo plano. Los recordatorios de vencimiento de tarjeta se envían 7, 5, 3 y 1 días antes del pago para tarjetas con saldo pendiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alertes de nouvelles transactions nécessitent l’actualisation en arrière-plan. Les rappels d’échéance de carte de crédit sont envoyés 7, 5, 3 et 1 jour avant l’échéance pour les cartes ayant un solde impayé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli avvisi di nuove transazioni richiedono l’aggiornamento in background. I promemoria di scadenza della carta vengono inviati 7, 5, 3 e 1 giorni prima del pagamento per le carte con saldo non pagato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe transactiewaarschuwingen vereisen vernieuwen op de achtergrond. Herinneringen voor creditcardvervaldata worden 7, 5, 3 en 1 dagen vóór de betaaldatum gestuurd voor kaarten met een openstaand saldo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alertas de novas transações exigem Atualização em Segundo Plano. Lembretes de vencimento do cartão são enviados 7, 5, 3 e 1 dias antes do pagamento para cartões com saldo pendente."
          }
        }
      }
    },
    "New transactions, Siri Shortcuts, and Wallet automation use the Default Account when no account is chosen." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Transaktionen, Siri-Kurzbefehle und Wallet-Automatisierungen verwenden das Standardkonto, wenn kein Konto ausgewählt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New transactions, Siri Shortcuts, and Wallet automation use the Default Account when no account is chosen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las nuevas transacciones, los atajos de Siri y la automatización de Wallet usan la cuenta predeterminada cuando no se selecciona ninguna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles transactions, les raccourcis Siri et l’automatisation Wallet utilisent le compte par défaut lorsqu’aucun compte n’est choisi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove transazioni, i comandi rapidi Siri e l’automazione Wallet usano il conto predefinito quando non ne viene scelto uno."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe transacties, Siri-opdrachten en Wallet-automatisering gebruiken de standaardrekening als er geen rekening is gekozen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novas transações, Atalhos da Siri e automações do Wallet usam a conta padrão quando nenhuma conta é escolhida."
          }
        }
      }
    },
    "New transactions, Siri Shortcuts, and Wallet automation use the Default Account when no account is chosen. Conventional Amount Entry types 324 as 324.00 instead of filling cents first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Transaktionen, Siri-Kurzbefehle und Wallet-Automatisierung verwenden das Standardkonto, wenn kein Konto ausgewählt ist. Bei konventioneller Betragseingabe wird 324 als 324,00 eingegeben, statt zuerst die Cent-Stellen zu füllen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New transactions, Siri Shortcuts, and Wallet automation use the Default Account when no account is chosen. Conventional Amount Entry types 324 as 324.00 instead of filling cents first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las nuevas transacciones, los atajos de Siri y la automatización de Wallet utilizan la cuenta predeterminada cuando no se elige ninguna cuenta. La introducción convencional de importes escribe 324 como 324,00 en lugar de rellenar primero los centavos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles transactions, les raccourcis Siri et l'automatisation Wallet utilisent le compte par défaut lorsqu'aucun compte n'est choisi. La saisie de montant conventionnelle tape 324 comme 324,00 au lieu de remplir d'abord les centimes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove transazioni, le Shortcuts di Siri e l'automazione Wallet utilizzano il Conto predefinito quando non viene scelto alcun conto. L'inserimento importo convenzionale digita 324 come 324,00 invece di riempire prima i centesimi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe transacties, Siri-opdrachten en Wallet-automatisering gebruiken de standaardrekening wanneer geen rekening is gekozen. Conventionele bedraginvoer typt 324 als 324,00 in plaats van eerst de centen te vullen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novas transações, Atalhos do Siri e automação da Wallet usam a Conta padrão quando nenhuma conta é escolhida. A Entrada de Valor Convencional digita 324 como 324,00 em vez de preencher os centavos primeiro."
          }
        }
      }
    },
