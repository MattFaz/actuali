            "state" : "translated",
            "value" : "A automação de financiamento não conseguiu carregar o mês do orçamento: %@"
          }
        }
      }
    },
    "Category funding automation couldn't verify the saved transaction: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
