    "Link Apple Card, Apple Cash and Savings so their transactions and balances import automatically when you sync. Apple asks once which data Actuali may read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link Apple Card, Apple Cash and Savings so their transactions and balances import automatically when you sync. Apple asks once which data Actuali may read."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liez Apple Card, Apple Cash et Savings pour que leurs transactions et soldes soient importés automatiquement lors de la synchronisation. Apple demande une seule fois à quelles données Actuali peut accéder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincule Apple Card, Apple Cash y Savings para que sus transacciones y saldos se importen automáticamente al sincronizar. Apple preguntará una vez a qué datos puede acceder Actuali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincule o Apple Card, Apple Cash e Savings para que suas transações e saldos sejam importados automaticamente ao sincronizar. A Apple pergunta uma vez quais dados o Actuali pode ler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verknüpfen Sie Apple Card, Apple Cash und Savings, damit deren Transaktionen und Salden automatisch beim Synchronisieren importiert werden. Apple fragt einmalig, auf welche Daten Actuali zugreifen darf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega Apple Card, Apple Cash e Savings in modo che le loro transazioni e i saldi vengano importati automaticamente durante la sincronizzazione. Apple chiede una sola volta a quali dati Actuali può accedere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel Apple Card, Apple Cash en Savings zodat hun transacties en saldi automatisch worden geïmporteerd wanneer u synchroniseert. Apple vraagt eenmalig welke gegevens Actuali mag lezen."
          }
        }
      }
    },
    "Link to an existing account": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link to an existing account"
          }
        },
        "fr": {
