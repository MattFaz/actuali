            "value": "Associações de cartões"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartenzuordnungen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappature delle carte"
          }
        },
        "nl": {
          "stringUnit": {
