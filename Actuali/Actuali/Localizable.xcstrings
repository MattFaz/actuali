          }
        }
      }
    },
    "Your server has no SimpleFIN connection of its own, so this device uses the token you gave it. Accounts you link here still appear in the web app, but it needs its own SimpleFIN setup to sync them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Server verfügt über keine eigene SimpleFIN-Verbindung, daher verwendet dieses Gerät das Ihnen zugewiesene Token. Konten, die Sie hier verknüpfen, erscheinen weiterhin in der Web-App, benötigt jedoch eine eigene SimpleFIN-Einrichtung, um sie zu synchronisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your server has no SimpleFIN connection of its own, so this device uses the token you gave it. Accounts you link here still appear in the web app, but it needs its own SimpleFIN setup to sync them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su servidor no tiene su propia conexión SimpleFIN, por lo que este dispositivo usa el token que le proporcionó. Las cuentas que vincule aquí seguirán apareciendo en la app web, pero esta necesitará su propia configuración de SimpleFIN para sincronizarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur n'a pas sa propre connexion SimpleFIN, cet appareil utilise donc le jeton que vous lui avez fourni. Les comptes que vous liez ici apparaissent toujours dans l'app web, mais celle-ci a besoin de sa propre configuration SimpleFIN pour les synchroniser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo server non ha una propria connessione SimpleFIN, quindi questo dispositivo utilizza il token che gli hai fornito. I conti che colleghi qui appaiono comunque nell'app web, ma questa necessita di una propria configurazione SimpleFIN per sincronizzarli."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw server heeft geen eigen SimpleFIN-verbinding, dus dit apparaat gebruikt het token dat u eraan hebt gegeven. Rekeningen die u hier koppelt, verschijnen nog steeds in de webapp, maar deze heeft een eigen SimpleFIN-configuratie nodig om ze te synchroniseren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor não tem sua própria conexão SimpleFIN, então este dispositivo usa o token que você forneceu a ele. Contas vinculadas aqui ainda aparecem no app web, mas ele precisa de sua própria configuração do SimpleFIN para sincronizá-las."
          }
        }
      }
    },
    "Your server took too long to respond. It may be offline, or blocked on this network. See %@ for help." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat zu lange zum Antworten gebraucht. Er ist möglicherweise offline. Hilfe: %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your server took too long to respond. It may be offline, or blocked on this network. See %@ for help."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor tardó demasiado en responder. Puede estar desconectado. Consulta %@."
