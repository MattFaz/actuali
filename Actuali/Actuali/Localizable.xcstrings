          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta padrão não está mais disponível. Configure uma nova padrão em Mais → Transações e Automação."
          }
        }
      }
    },
    "Your device isn't connected to the internet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gerät ist nicht mit dem Internet verbunden."
          }
        },
        "en" : {
          "stringUnit" : {
