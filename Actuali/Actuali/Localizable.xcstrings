    "No accounts yet. Add a bank at SimpleFIN, then pull to refresh.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No accounts yet. Add a bank at SimpleFIN, then pull to refresh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte pour le moment. Ajoutez une banque sur SimpleFIN, puis tirez vers le bas pour actualiser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay cuentas. Añada un banco en SimpleFIN y luego deslice hacia abajo para actualizar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há contas. Adicione um banco no SimpleFIN e depois puxe para atualizar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Konten. Fügen Sie eine Bank bei SimpleFIN hinzu und ziehen Sie dann zum Aktualisieren nach unten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun conto ancora. Aggiungi una banca su SimpleFIN, poi trascina verso il basso per aggiornare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen rekeningen. Voeg een bank toe bij SimpleFIN en trek vervolgens naar beneden om te vernieuwen."
          }
        }
      }
    },
    "No budgets were found on your server. Tap Create New Budget to make one, or Refresh Budgets if you've created one elsewhere.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No budgets were found on your server. Tap Create New Budget to make one, or Refresh Budgets if you've created one elsewhere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun budget trouvé sur votre serveur. Appuyez sur Créer un nouveau budget pour en créer un, ou sur Actualiser les budgets si vous en avez déjà créé un ailleurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron presupuestos en su servidor. Toque Crear nuevo presupuesto para crear uno, o Actualizar presupuestos si ya ha creado uno en otro lugar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum orçamento foi encontrado no seu servidor. Toque em Criar novo orçamento para criar um, ou em Atualizar orçamentos se já criou um em outro lugar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Ihrem Server wurden keine Budgets gefunden. Tippen Sie auf „Neues Budget erstellen“, um eines zu erstellen, oder auf „Budgets aktualisieren“, wenn Sie bereits an anderer Stelle eines erstellt haben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun budget trovato sul tuo server. Tocca Crea nuovo budget per crearne uno, oppure Aggiorna budget se ne hai già creato uno altrove."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen budgetten gevonden op uw server. Tik op Nieuw budget maken om er een te maken, of op Budgetten vernieuwen als u er elders al een heeft gemaakt."
          }
        }
      }
    },
