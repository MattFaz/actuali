    "Nothing can cover this right now: To Budget is empty and no other category has available funds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies kann derzeit nicht gedeckt werden: Zu budgetieren ist leer und keine andere Kategorie hat verfügbare Mittel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing can cover this right now: To Budget is empty and no other category has available funds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada puede cubrir esto ahora: Por presupuestar está vacío y ninguna otra categoría tiene fondos disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne peut couvrir cela pour le moment : le budget à affecter est vide et aucune autre catégorie ne dispose de fonds."
