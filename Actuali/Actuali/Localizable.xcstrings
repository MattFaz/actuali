        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobrir move apenas o dinheiro orçado. Não altera nem duplica transações."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abdecken wird nur budgetiertes Geld verschoben. Transaktionen werden weder geändert noch dupliziert."
