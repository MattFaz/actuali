          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la transazione. Tocca per riprovare. (%@)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan transactie niet opslaan. Tik om het opnieuw te proberen. (%@)"
