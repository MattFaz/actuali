    "Select a budget to load it onto this device. The app stays empty until one is chosen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a budget to load it onto this device. The app stays empty until one is chosen."
          }
        },
        "fr": {
          "stringUnit": {
