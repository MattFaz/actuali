    "Your Actual server holds the SimpleFIN credentials, so this app and the web app share one connection — accounts you link in either place work in both.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Actual server holds the SimpleFIN credentials, so this app and the web app share one connection — accounts you link in either place work in both."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur Actual conserve les identifiants SimpleFIN, de sorte que cette app et l'app web partagent une seule connexion — les comptes que vous liez à un endroit fonctionnent aux deux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su servidor Actual guarda las credenciales de SimpleFIN, por lo que esta app y la app web comparten una sola conexión; las cuentas que vincule en cualquiera de los dos lugares funcionan en ambos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor Actual guarda as credenciais do SimpleFIN, então este app e o app web compartilham uma única conexão — contas que você vincula em qualquer um dos dois funcionam em ambos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Actual-Server verwaltet die SimpleFIN-Zugangsdaten, sodass diese App und die Web-App eine gemeinsame Verbindung nutzen – Konten, die Sie an einer Stelle verknüpfen, funktionieren an beiden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo server Actual conserva le credenziali SimpleFIN, quindi questa app e l'app web condividono un'unica connessione: i conti che colleghi in un punto funzionano in entrambi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw Actual-server bewaart de SimpleFIN-inloggegevens, zodat deze app en de webapp één verbinding delen — rekeningen die u op een van beide plekken koppelt, werken in beide."
          }
        }
      }
    },
    "Your accounts stay linked and keep the transactions they've already imported. To sync from this device again you'll need a new setup token.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your accounts stay linked and keep the transactions they've already imported. To sync from this device again you'll need a new setup token."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos comptes restent liés et conservent les transactions déjà importées. Pour synchroniser à nouveau depuis cet appareil, vous aurez besoin d'un nouveau jeton de configuration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus cuentas permanecen vinculadas y conservan las transacciones que ya se han importado. Para volver a sincronizar desde este dispositivo, necesitará un nuevo token de configuración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas contas permanecem vinculadas e mantêm as transações já importadas. Para sincronizar novamente a partir deste dispositivo, você precisará de um novo token de configuração."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Konten bleiben verknüpft und behalten die bereits importierten Transaktionen. Um von diesem Gerät erneut zu synchronisieren, benötigen Sie ein neues Einrichtungstoken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi conti rimangono collegati e conservano le transazioni già importate. Per sincronizzare di nuovo da questo dispositivo avrai bisogno di un nuovo token di configurazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw rekeningen blijven gekoppeld en behouden de al geïmporteerde transacties. Om vanaf dit apparaat opnieuw te synchroniseren, hebt u een nieuw installatietoken nodig."
          }
        }
      }
    },
    "Your default account is no longer available. Please configure a new default in More → Transactions & Automation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your default account is no longer available. Please configure a new default in More → Transactions & Automation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte par défaut n'est plus disponible. Veuillez configurer un nouveau compte par défaut dans Plus → Transactions et automatisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su cuenta predeterminada ya no está disponible. Configure una nueva en Más → Transacciones y automatización."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta padrão não está mais disponível. Configure uma nova padrão em Mais → Transações e Automação."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Standardkonto ist nicht mehr verfügbar. Bitte konfigurieren Sie einen neuen Standard unter Mehr → Transaktionen und Automatisierung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo conto predefinito non è più disponibile. Configura un nuovo predefinito in Altro → Transazioni e automazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw standaardrekening is niet meer beschikbaar. Configureer een nieuwe standaard in Meer → Transacties en automatisering."
          }
        }
      }
    },
    "Your server has no SimpleFIN connection of its own, so this device uses the token you gave it. Accounts you link here still appear in the web app, but it needs its own SimpleFIN setup to sync them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server has no SimpleFIN connection of its own, so this device uses the token you gave it. Accounts you link here still appear in the web app, but it needs its own SimpleFIN setup to sync them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur n'a pas sa propre connexion SimpleFIN, cet appareil utilise donc le jeton que vous lui avez fourni. Les comptes que vous liez ici apparaissent toujours dans l'app web, mais celle-ci a besoin de sa propre configuration SimpleFIN pour les synchroniser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su servidor no tiene su propia conexión SimpleFIN, por lo que este dispositivo usa el token que le proporcionó. Las cuentas que vincule aquí seguirán apareciendo en la app web, pero esta necesitará su propia configuración de SimpleFIN para sincronizarlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor não tem sua própria conexão SimpleFIN, então este dispositivo usa o token que você forneceu a ele. Contas vinculadas aqui ainda aparecem no app web, mas ele precisa de sua própria configuração do SimpleFIN para sincronizá-las."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Server verfügt über keine eigene SimpleFIN-Verbindung, daher verwendet dieses Gerät das Ihnen zugewiesene Token. Konten, die Sie hier verknüpfen, erscheinen weiterhin in der Web-App, benötigt jedoch eine eigene SimpleFIN-Einrichtung, um sie zu synchronisieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo server non ha una propria connessione SimpleFIN, quindi questo dispositivo utilizza il token che gli hai fornito. I conti che colleghi qui appaiono comunque nell'app web, ma questa necessita di una propria configurazione SimpleFIN per sincronizzarli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw server heeft geen eigen SimpleFIN-verbinding, dus dit apparaat gebruikt het token dat u eraan hebt gegeven. Rekeningen die u hier koppelt, verschijnen nog steeds in de webapp, maar deze heeft een eigen SimpleFIN-configuratie nodig om ze te synchroniseren."
          }
        }
      }
    },
    "Sign-in needs an open window. Try again with the app in the foreground.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in needs an open window. Try again with the app in the foreground."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion nécessite une fenêtre ouverte. Réessayez avec l’app au premier plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión necesita una ventana abierta. Inténtalo de nuevo con la app en primer plano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de sessão precisa de uma janela aberta. Tente novamente com o app em primeiro plano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Anmeldung muss ein Fenster geöffnet sein. Versuche es erneut, während die App im Vordergrund ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso richiede una finestra aperta. Riprova con l’app in primo piano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor inloggen is een geopend venster nodig. Probeer het opnieuw terwijl de app op de voorgrond staat."
          }
        }
      }
    },
    "SimpleFIN rejected the saved access key. Disconnect SimpleFIN and set it up again with a new setup token.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN rejected the saved access key. Disconnect SimpleFIN and set it up again with a new setup token."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN a refusé la clé d’accès enregistrée. Déconnectez SimpleFIN et configurez-le à nouveau avec un nouveau jeton."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN rechazó la clave de acceso guardada. Desconecta SimpleFIN y configúralo de nuevo con un token nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SimpleFIN rejeitou a chave de acesso salva. Desconecte o SimpleFIN e configure-o novamente com um novo token."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN hat den gespeicherten Zugriffsschlüssel abgelehnt. Trenne SimpleFIN und richte es mit einem neuen Einrichtungstoken erneut ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN ha rifiutato la chiave di accesso salvata. Disconnetti SimpleFIN e configuralo di nuovo con un nuovo token."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN heeft de opgeslagen toegangssleutel geweigerd. Koppel SimpleFIN los en stel het opnieuw in met een nieuw insteltoken."
          }
        }
      }
    },
    "SimpleFIN rejected this setup token. Tokens can only be claimed once — generate a new one at SimpleFIN and paste that.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN rejected this setup token. Tokens can only be claimed once — generate a new one at SimpleFIN and paste that."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN a refusé ce jeton de configuration. Les jetons ne peuvent être utilisés qu’une fois. Générez-en un nouveau sur SimpleFIN et collez-le ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN rechazó este token de configuración. Los tokens solo se pueden reclamar una vez. Genera uno nuevo en SimpleFIN y pégalo aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SimpleFIN rejeitou este token de configuração. Os tokens só podem ser usados uma vez. Gere um novo no SimpleFIN e cole-o aqui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN hat dieses Einrichtungstoken abgelehnt. Tokens können nur einmal eingelöst werden. Erstelle bei SimpleFIN ein neues und füge es hier ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN ha rifiutato questo token di configurazione. I token possono essere riscattati una sola volta. Generane uno nuovo su SimpleFIN e incollalo qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN heeft dit insteltoken geweigerd. Tokens kunnen maar één keer worden gebruikt. Genereer een nieuw token bij SimpleFIN en plak het hier."
          }
        }
      }
    },
    "SimpleFIN returned a response Actuali couldn't read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN returned a response Actuali couldn't read."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN a renvoyé une réponse qu’Actuali n’a pas pu lire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN devolvió una respuesta que Actuali no pudo leer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SimpleFIN retornou uma resposta que o Actuali não conseguiu ler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN hat eine Antwort gesendet, die Actuali nicht lesen konnte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN ha restituito una risposta che Actuali non ha potuto leggere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SimpleFIN gaf een antwoord terug dat Actuali niet kon lezen."
          }
        }
      }
    },
    "SimpleFIN returned an unexpected response (HTTP %lld).": {
      "localizations": {
        "en": {
