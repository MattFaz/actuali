    "Go to More → Connection & Data to connect to your Actual Budget server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to More → Connection & Data to connect to your Actual Budget server"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans Plus → Connexion et données pour vous connecter à votre serveur Actual Budget"
          }
        },
