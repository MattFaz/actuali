    "Hide Balances" : {
      "comment" : "Settings toggle for masking amounts",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salden ausblenden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide Balances"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar saldos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer les soldes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi saldi"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldi verbergen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar saldos"
          }
        }
      }
    },
    "Hide Balances masks amounts across the app while leaving amount entry and reconciliation visible. Shake to Toggle lets you quickly mask or unmask amounts by shaking your phone. Hide Decimal Places rounds displayed amounts to whole units without changing their values." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salden ausblenden verdeckt Beträge in der gesamten App, während Betragseingabe und Abgleich sichtbar bleiben. Zum Umschalten schütteln lässt Sie Beträge durch Schütteln des Telefons schnell verdecken oder aufdecken. Dezimalstellen ausblenden rundet angezeigte Beträge auf ganze Einheiten, ohne ihre Werte zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide Balances masks amounts across the app while leaving amount entry and reconciliation visible. Shake to Toggle lets you quickly mask or unmask amounts by shaking your phone. Hide Decimal Places rounds displayed amounts to whole units without changing their values."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar saldos enmascara los importes en toda la app, dejando visible la introducción de importes y la conciliación. Agitar para alternar le permite enmascarar o desenmascarar rápidamente los importes agitando el teléfono. Ocultar decimales redondea los importes mostrados a unidades enteras sin cambiar sus valores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer les soldes masque les montants dans toute l'app, tout en laissant visibles la saisie des montants et le rapprochement. Secouer pour basculer permet de masquer ou d'afficher rapidement les montants en secouant votre téléphone. Masquer les décimales arrondit les montants affichés à l'unité entière sans modifier leurs valeurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi saldi maschera gli importi in tutta l'app, lasciando visibili l'inserimento degli importi e la riconciliazione. Agita per alternare ti consente di mascherare o smascherare rapidamente gli importi agitando il telefono. Nascondi decimali arrotonda gli importi visualizzati a unità intere senza modificarne i valori."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldi verbergen maskeert bedragen in de hele app, terwijl bedraginvoer en afstemming zichtbaar blijven. Schudden om te schakelen laat u bedragen snel maskeren of onthullen door met uw telefoon te schudden. Decimalen verbergen rondt weergegeven bedragen af op hele eenheden zonder de waarden te wijzigen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar saldos mascara os valores em todo o app, mantendo visíveis a entrada de valores e a reconciliação. Sacudir para alternar permite mascarar ou revelar rapidamente os valores sacudindo o telefone. Ocultar casas decimais arredonda os valores exibidos para unidades inteiras sem alterar seus valores."
          }
        }
      }
    },
