    "Category funding automation couldn't load the budget month: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Finanzierungsautomatisierung konnte den Budgetmonat nicht laden: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Category funding automation couldn't load the budget month: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La automatización de financiación no pudo cargar el mes presupuestario: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
