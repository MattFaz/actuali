        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento nulla può coprire questo importo: il budget da assegnare è vuoto e nessun'altra categoria ha fondi disponibili."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit kan nu nergens mee worden gedekt: Te budgetteren is leeg en geen andere categorie heeft beschikbare middelen."
