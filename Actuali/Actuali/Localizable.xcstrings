            "value": "Nueva cuenta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova conta"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neues Konto"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuovo conto"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe rekening"
          }
        }
      }
    },
    "New transactions, Siri Shortcuts, and Wallet automation use the Default Account when no account is chosen. Conventional Amount Entry types 324 as 324.00 instead of filling cents first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New transactions, Siri Shortcuts, and Wallet automation use the Default Account when no account is chosen. Conventional Amount Entry types 324 as 324.00 instead of filling cents first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles transactions, les raccourcis Siri et l'automatisation Wallet utilisent le compte par défaut lorsqu'aucun compte n'est choisi. La saisie de montant conventionnelle tape 324 comme 324,00 au lieu de remplir d'abord les centimes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las nuevas transacciones, los atajos de Siri y la automatización de Wallet utilizan la cuenta predeterminada cuando no se elige ninguna cuenta. La introducción convencional de importes escribe 324 como 324,00 en lugar de rellenar primero los centavos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novas transações, Atalhos do Siri e automação da Wallet usam a Conta padrão quando nenhuma conta é escolhida. A Entrada de Valor Convencional digita 324 como 324,00 em vez de preencher os centavos primeiro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Transaktionen, Siri-Kurzbefehle und Wallet-Automatisierung verwenden das Standardkonto, wenn kein Konto ausgewählt ist. Bei konventioneller Betragseingabe wird 324 als 324,00 eingegeben, statt zuerst die Cent-Stellen zu füllen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove transazioni, le Shortcuts di Siri e l'automazione Wallet utilizzano il Conto predefinito quando non viene scelto alcun conto. L'inserimento importo convenzionale digita 324 come 324,00 invece di riempire prima i centesimi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe transacties, Siri-opdrachten en Wallet-automatisering gebruiken de standaardrekening wanneer geen rekening is gekozen. Conventionele bedraginvoer typt 324 als 324,00 in plaats van eerst de centen te vullen."
          }
        }
      }
    },
