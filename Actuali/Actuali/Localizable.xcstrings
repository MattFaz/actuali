    "We have merged your existing automations with the notes for this category. Please review and edit as needed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We have merged your existing automations with the notes for this category. Please review and edit as needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons fusionné vos automatisations existantes avec les notes de cette catégorie. Veuillez les vérifier et les modifier si nécessaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
