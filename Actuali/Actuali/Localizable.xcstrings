          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai a Altro → Connessione e dati per collegarti al server Actual Budget"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga naar Meer → Verbinding en gegevens om verbinding te maken met je Actual Budget-server"
          }
        }
      }
    },
    "You're connected. Choose a budget in More → Connection & Data to load it here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're connected. Choose a budget in More → Connection & Data to load it here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes connecté. Choisissez un budget dans Plus → Connexion et données pour le charger ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás conectado. Elige un presupuesto en Más → Conexión y datos para cargarlo aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está conectado. Escolha um orçamento em Mais → Conexão e dados para carregá-lo aqui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist verbunden. Wähle unter Mehr → Verbindung & Daten ein Budget, um es hier zu laden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei connesso. Scegli un budget in Altro → Connessione e dati per caricarlo qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent verbonden. Kies een budget via Meer → Verbinding en gegevens om het hier te laden."
          }
        }
      }
    },
