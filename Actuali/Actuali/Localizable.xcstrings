          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontraron presupuestos en tu servidor. Crea uno en Actual Budget y toca Actualizar presupuestos."
          }
        },
        "fr" : {
          "stringUnit" : {
