    "Set up a Shortcuts automation that logs tap-to-pay purchases from Apple Wallet, or import Apple Card, Apple Cash and Savings transactions directly." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
