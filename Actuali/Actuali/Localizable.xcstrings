    "Couldn't make a secure connection to your server — iOS doesn't trust its security certificate. This usually means the server is using its own self-signed certificate. See %@ for how to fix it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't make a secure connection to your server — iOS doesn't trust its security certificate. This usually means the server is using its own self-signed certificate. See %@ for how to fix it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’établir une connexion sécurisée à votre serveur : iOS ne fait pas confiance à son certificat. Consultez %@ pour savoir comment résoudre le problème."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo establecer una conexión segura con el servidor: iOS no confía en su certificado. Consulta %@ para solucionarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível estabelecer uma conexão segura com o servidor: o iOS não confia no certificado. Consulte %@ para saber como corrigir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine sichere Verbindung zum Server möglich: iOS vertraut seinem Zertifikat nicht. Unter %@ findest du Hilfe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile stabilire una connessione sicura al server: iOS non considera attendibile il certificato. Consulta %@ per risolvere il problema."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan geen veilige verbinding met de server maken: iOS vertrouwt het certificaat niet. Zie %@ voor hulp."
          }
        }
      }
    },
    "Your server's security certificate has expired, so iOS blocked the connection. Renewing the certificate on the server will fix this. See %@ for help.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server's security certificate has expired, so iOS blocked the connection. Renewing the certificate on the server will fix this. See %@ for help."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de votre serveur a expiré et iOS a bloqué la connexion. Renouvelez-le. Consultez %@ pour obtenir de l’aide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado del servidor ha caducado y iOS bloqueó la conexión. Renueva el certificado. Consulta %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado do servidor expirou e o iOS bloqueou a conexão. Renove-o. Consulte %@ para obter ajuda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Serverzertifikat ist abgelaufen, daher hat iOS die Verbindung blockiert. Erneuere es. Hilfe findest du unter %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il certificato del server è scaduto e iOS ha bloccato la connessione. Rinnovalo. Consulta %@ per assistenza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het servercertificaat is verlopen, dus iOS blokkeerde de verbinding. Vernieuw het. Zie %@ voor hulp."
          }
        }
      }
    },
    "Actuali can only connect over a secure address. Check that your server URL starts with https:// — see %@ for help.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actuali can only connect over a secure address. Check that your server URL starts with https:// — see %@ for help."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actuali ne peut se connecter qu’à une adresse sécurisée. Vérifiez que l’URL commence par https://. Consultez %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actuali solo puede conectarse mediante una dirección segura. Comprueba que la URL empiece por https://. Consulta %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Actuali só pode se conectar por um endereço seguro. Verifique se a URL começa com https://. Consulte %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Actuali kann nur über eine sichere Adresse verbinden. Prüfe, ob die URL mit https:// beginnt. Hilfe: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Actuali può connettersi solo a un indirizzo sicuro. Verifica che l’URL inizi con https://. Consulta %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actuali kan alleen via een veilig adres verbinden. Controleer of de URL met https:// begint. Zie %@."
          }
        }
      }
    },
    "Couldn't find a server at that address. Check the server URL for typos. See %@ for help.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't find a server at that address. Check the server URL for typos. See %@ for help."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun serveur trouvé à cette adresse. Vérifiez l’URL. Consultez %@ pour obtenir de l’aide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún servidor en esa dirección. Comprueba la URL. Consulta %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum servidor foi encontrado nesse endereço. Verifique a URL. Consulte %@ para obter ajuda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dieser Adresse wurde kein Server gefunden. Prüfe die URL. Hilfe: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun server trovato a quell’indirizzo. Verifica l’URL. Consulta %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen server gevonden op dat adres. Controleer de URL. Zie %@ voor hulp."
          }
        }
      }
    },
    "Couldn't reach your server. If it's only available on your home network, connect to that network and try again. See %@ for help.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach your server. If it's only available on your home network, connect to that network and try again. See %@ for help."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre votre serveur. Connectez-vous à votre réseau domestique et réessayez. Consultez %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder al servidor. Conéctate a tu red doméstica y vuelve a intentarlo. Consulta %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o servidor. Conecte-se à sua rede doméstica e tente novamente. Consulte %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist nicht erreichbar. Verbinde dich mit deinem Heimnetzwerk und versuche es erneut. Hilfe: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il server. Connettiti alla rete domestica e riprova. Consulta %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
