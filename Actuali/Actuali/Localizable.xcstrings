    "“%@” is end-to-end encrypted. Enter its encryption password to open it on this device. This is separate from your server password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist Ende-zu-Ende-verschlüsselt. Gib das Verschlüsselungspasswort ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is end-to-end encrypted. Enter its encryption password to open it on this device. This is separate from your server password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » está cifrado de extremo a extremo. Introduce su contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est chiffré de bout en bout. Saisissez son mot de passe de chiffrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è crittografato end-to-end. Inserisci la password di crittografia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is end-to-end versleuteld. Voer het versleutelingswachtwoord in."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” é criptografado de ponta a ponta. Digite a senha de criptografia."
          }
        }
      }
    },
    "“%@” was created on your server, but couldn't be finished on this device: %@ Select it in Budget Selection to download it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wurde auf Ihrem Server erstellt, konnte auf diesem Gerät aber nicht fertiggestellt werden: %@ Wählen Sie es unter Budgetauswahl aus, um es zu laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” was created on your server, but couldn't be finished on this device: %@ Select it in Budget Selection to download it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» se creó en tu servidor, pero no se pudo finalizar en este dispositivo: %@ Selecciónalo en Selección de presupuesto para descargarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a été créé sur votre serveur, mais n'a pas pu être terminé sur cet appareil : %@ Sélectionnez-le dans Sélection du budget pour le télécharger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è stato creato sul server, ma non è stato possibile completarlo su questo dispositivo: %@ Selezionalo in Selezione budget per scaricarlo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ is op je server aangemaakt, maar kon niet op dit apparaat worden voltooid: %@ Selecteer het in Budgetselectie om het te downloaden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” foi criado no seu servidor, mas não pôde ser concluído neste dispositivo: %@ Selecione-o em Seleção de Orçamento para baixá-lo."
          }
        }
      }
    },
    "«%@» is removed from this device, including its local backups. Any changes that haven't synced to the server yet will be lost. The budget stays on your server and can be downloaded again." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird von diesem Gerät und seinen lokalen Backups entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» is removed from this device, including its local backups. Any changes that haven't synced to the server yet will be lost. The budget stays on your server and can be downloaded again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » se eliminará de este dispositivo, incluidas sus copias locales."
          }
        },
        "fr" : {
