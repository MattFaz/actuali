    "Removes “%@” from this device, including its local backups. Any changes that haven't synced to the server yet will be lost. The budget stays on your server and can be downloaded again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt „%@“ von diesem Gerät und aus lokalen Backups."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes “%@” from this device, including its local backups. Any changes that haven't synced to the server yet will be lost. The budget stays on your server and can be downloaded again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina « %@ » de este dispositivo y sus copias locales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime « %@ » de cet appareil, y compris ses sauvegardes locales. Les changements non synchronisés seront perdus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove «%@» da questo dispositivo e dai backup locali."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert “%@” van dit apparaat en lokale back-ups."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove “%@” deste dispositivo, incluindo os backups locais."
          }
        }
      }
    },
    "Renders these automations as #template lines into the category note and hands control back to notes-based templates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wandelt diese Automatisierungen in #template-Zeilen in der Kategorienotiz um und gibt die Kontrolle zurück an notizbasierte Vorlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renders these automations as #template lines into the category note and hands control back to notes-based templates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte estas automatizaciones en líneas #template en la nota de la categoría y devuelve el control a las plantillas basadas en notas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertit ces automatisations en lignes #template dans la note de la catégorie et redonne le contrôle aux modèles basés sur des notes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converte queste automazioni in righe #template nella nota della categoria e restituisce il controllo ai modelli basati sulle note."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet deze automatiseringen om in #template-regels in de categorienotitie en geeft de controle terug aan op notities gebaseerde sjablonen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converte essas automações em linhas #template na nota da categoria e devolve o controle aos modelos baseados em notas."
          }
        }
      }
    },
