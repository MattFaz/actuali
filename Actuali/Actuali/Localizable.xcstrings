            "value": "Einen Zielbetrag bis zu einer Frist auf die Monate verteilen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuire un importo obiettivo sui mesi fino alla scadenza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een doelbedrag tot een deadline over de maanden verdelen."
          }
        }
      }
    },
    "A share of this month's or last month's income.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A share of this month's or last month's income."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une part des revenus de ce mois ou du mois dernier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte de los ingresos de este mes o del anterior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma parte da renda deste mês ou do mês passado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Anteil des Einkommens dieses oder letzten Monats."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte del reddito di questo mese o del mese scorso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een deel van het inkomen van deze of vorige maand."
          }
        }
      }
    },
    "Use past months: average, a specific month, or a copy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use past months: average, a specific month, or a copy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser les mois passés : moyenne, mois précis ou copie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar meses anteriores: media, mes específico o copia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar meses anteriores: média, mês específico ou cópia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergangene Monate verwenden: Durchschnitt, bestimmter Monat oder Kopie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa mesi passati: media, mese specifico o copia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik eerdere maanden: gemiddelde, specifieke maand of kopie."
          }
        }
      }
    },
    "Stop budgeting to this category once the balance reaches a cap.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop budgeting to this category once the balance reaches a cap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter de budgéter cette catégorie lorsque le solde atteint un plafond."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja de presupuestar esta categoría cuando el saldo alcance un límite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare de orçar esta categoria quando o saldo atingir um limite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Kategorie nicht weiter budgetieren, sobald der Saldo ein Limit erreicht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smetti di budgetizzare questa categoria quando il saldo raggiunge un limite."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop met budgetteren voor deze categorie zodra het saldo een limiet bereikt."
          }
        }
      }
    },
    "Top the category back up to the balance cap each month.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top the category back up to the balance cap each month."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recompléter la catégorie jusqu’au plafond chaque mois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellenar la categoría hasta el límite cada mes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repor a categoria até o limite todos os meses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kategorie jeden Monat bis zum Kontostandlimit auffüllen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riporta la categoria al limite ogni mese."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De categorie elke maand tot de limiet aanvullen."
          }
        }
      }
    },
    "Split any remaining To Budget across these categories.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split any remaining To Budget across these categories."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répartir tout le montant restant à budgéter entre ces catégories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repartir los fondos restantes entre estas categorías."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dividir os fundos restantes para orçamento entre estas categorias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbleibende Budgetmittel auf diese Kategorien verteilen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dividi i fondi rimanenti da mettere a budget tra queste categorie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Resterende budgetmiddelen over deze categorieën verdelen."
          }
        }
      }
    },
    "Set a long-term savings target. This changes the coloring of the balance on the budget page to be based on progress towards the target rather than the current month funding progress.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a long-term savings target. This changes the coloring of the balance on the budget page to be based on progress towards the target rather than the current month funding progress."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir un objectif d’épargne à long terme. La couleur du solde dépendra de la progression vers cet objectif."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece un objetivo de ahorro a largo plazo. El color del saldo dependerá del progreso hacia el objetivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina uma meta de poupança de longo prazo. A cor do saldo dependerá do progresso em direção à meta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein langfristiges Sparziel festlegen. Die Farbe des Saldos richtet sich dann nach dem Fortschritt zum Ziel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un obiettivo di risparmio a lungo termine. Il colore del saldo dipenderà dai progressi verso l’obiettivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een langetermijnspaardoel in. De kleur van het saldo hangt dan af van de voortgang naar het doel."
          }
        }
      }
    },
