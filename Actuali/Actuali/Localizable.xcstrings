    "Carry overspending into next month instead of taking it from To Budget. Applies from %@ onward." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übertrage den Überschuss in den nächsten Monat, statt ihn aus dem zu budgetierenden Betrag zu nehmen. Gilt ab %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carry overspending into next month instead of taking it from To Budget. Applies from %@ onward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra el exceso al mes siguiente en lugar de tomarlo de Por presupuestar. Se aplica desde %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reporter le dépassement au mois suivant au lieu de le prendre du budget à affecter. S'applique à partir de %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riporta l'eccesso al mese successivo invece di prenderlo dal budget da assegnare. Si applica da %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem het overschot mee naar de volgende maand in plaats van het van Te budgetteren af te trekken. Geldt vanaf %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levar o excesso para o próximo mês em vez de retirá-lo de A orçar. Aplica-se a partir de %@."
          }
        }
      }
    },
    "Carry this category's balance into next month. Applies from %@ onward." : {
