    "Schedule and save-by-date automations must all share one priority, or none of them will budget." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitplan- und Bis-Datum-sparen-Automatisierungen müssen dieselbe Priorität haben, sonst budgetiert keine von ihnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schedule and save-by-date automations must all share one priority, or none of them will budget."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las automatizaciones de calendario y ahorro por fecha deben compartir una prioridad, o ninguna presupuestará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les automatisations de calendrier et d'épargne par date doivent toutes avoir la même priorité, sinon aucune ne budgétisera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le automazioni di programmazione e risparmio entro una data devono condividere una priorità, altrimenti nessuna assegnerà fondi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatiseringen voor planning en sparen vóór een datum moeten dezelfde prioriteit hebben, anders maakt geen ervan een budget."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As automações de agendamento e economia por data devem ter a mesma prioridade, ou nenhuma fará o orçamento."
          }
        }
      }
    },
