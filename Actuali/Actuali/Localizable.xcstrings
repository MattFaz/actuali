    "Lower priorities budget first; priorities above 0 stop once available funds run out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedrigere Prioritäten werden zuerst budgetiert; Prioritäten über 0 stoppen, sobald die verfügbaren Mittel aufgebraucht sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower priorities budget first; priorities above 0 stop once available funds run out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las prioridades más bajas se presupuestan primero; las prioridades superiores a 0 se detienen cuando se agotan los fondos disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les priorités les plus basses sont budgétées en premier ; les priorités supérieures à 0 s'arrêtent une fois les fonds disponibles épuisés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le priorità più basse vengono messe a budget per prime; le priorità superiori a 0 si fermano quando i fondi disponibili si esauriscono."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagere prioriteiten worden eerst gebudgetteerd; prioriteiten boven 0 stoppen zodra de beschikbare middelen op zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioridades mais baixas são orçadas primeiro; prioridades acima de 0 param quando os fundos disponíveis se esgotam."
          }
        }
      }
    },
