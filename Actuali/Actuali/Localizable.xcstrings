    "Your accounts stay linked and keep the transactions they've already imported. To sync from this device again you'll need a new setup token." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Konten bleiben verknüpft und behalten die bereits importierten Transaktionen. Um von diesem Gerät erneut zu synchronisieren, benötigen Sie ein neues Einrichtungstoken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your accounts stay linked and keep the transactions they've already imported. To sync from this device again you'll need a new setup token."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus cuentas permanecen vinculadas y conservan las transacciones que ya se han importado. Para volver a sincronizar desde este dispositivo, necesitará un nuevo token de configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos comptes restent liés et conservent les transactions déjà importées. Pour synchroniser à nouveau depuis cet appareil, vous aurez besoin d'un nouveau jeton de configuration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi conti rimangono collegati e conservano le transazioni già importate. Per sincronizzare di nuovo da questo dispositivo avrai bisogno di un nuovo token di configurazione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw rekeningen blijven gekoppeld en behouden de al geïmporteerde transacties. Om vanaf dit apparaat opnieuw te synchroniseren, hebt u een nieuw installatietoken nodig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas contas permanecem vinculadas e mantêm as transações já importadas. Para sincronizar novamente a partir deste dispositivo, você precisará de um novo token de configuração."
          }
        }
      }
    },
    "Your Actual server holds the SimpleFIN credentials, so this app and the web app share one connection — accounts you link in either place work in both." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Actual-Server verwaltet die SimpleFIN-Zugangsdaten, sodass diese App und die Web-App eine gemeinsame Verbindung nutzen – Konten, die Sie an einer Stelle verknüpfen, funktionieren an beiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Actual server holds the SimpleFIN credentials, so this app and the web app share one connection — accounts you link in either place work in both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su servidor Actual guarda las credenciales de SimpleFIN, por lo que esta app y la app web comparten una sola conexión; las cuentas que vincule en cualquiera de los dos lugares funcionan en ambos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur Actual conserve les identifiants SimpleFIN, de sorte que cette app et l'app web partagent une seule connexion — les comptes que vous liez à un endroit fonctionnent aux deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo server Actual conserva le credenziali SimpleFIN, quindi questa app e l'app web condividono un'unica connessione: i conti che colleghi in un punto funzionano in entrambi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw Actual-server bewaart de SimpleFIN-inloggegevens, zodat deze app en de webapp één verbinding delen — rekeningen die u op een van beide plekken koppelt, werken in beide."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor Actual guarda as credenciais do SimpleFIN, então este app e o app web compartilham uma única conexão — contas que você vincula em qualquer um dos dois funcionam em ambos."
          }
        }
      }
    },
    "Your cleared balance needs %@ to match the bank. The adjustment is a cleared transaction for that amount; you can lock afterwards." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein bestätigter Saldo benötigt %@, um mit der Bank übereinzustimmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your cleared balance needs %@ to match the bank. The adjustment is a cleared transaction for that amount; you can lock afterwards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu saldo conciliado necesita %@ para coincidir con el banco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre solde pointé doit être ajusté de %@ pour correspondre à la banque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il saldo registrato deve essere adeguato di %@ per corrispondere alla banca."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gemarkeerde saldo heeft %@ nodig om overeen te komen met de bank."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu saldo confirmado precisa de %@ para corresponder ao banco."
          }
        }
      }
    },
    "Your current data is saved first so you can revert." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre aktuellen Daten werden zunächst gespeichert, damit Sie sie wiederherstellen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your current data is saved first so you can revert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero se guardan sus datos actuales para que pueda volver atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données actuelles sont d'abord sauvegardées afin de pouvoir revenir en arrière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati attuali vengono salvati per primi in modo da poterli ripristinare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw huidige gegevens worden eerst opgeslagen, zodat u deze kunt herstellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados atuais são salvos primeiro para que você possa reverter."
          }
        }
      }
    },
    "Your default account is no longer available. Please configure a new default in More → Transactions & Automation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Standardkonto ist nicht mehr verfügbar. Bitte konfigurieren Sie einen neuen Standard unter Mehr → Transaktionen und Automatisierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your default account is no longer available. Please configure a new default in More → Transactions & Automation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su cuenta predeterminada ya no está disponible. Configure una nueva en Más → Transacciones y automatización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte par défaut n'est plus disponible. Veuillez configurer un nouveau compte par défaut dans Plus → Transactions et automatisation."
          }
        },
        "it" : {
          "stringUnit" : {
