    "When a new expense is manually entered from the selected account and would overdraw its category, Actuali automatically funds only the amount needed to cover that expense." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine neue Ausgabe vom ausgewählten Konto die Kategorie überzieht, finanziert Actuali automatisch nur den benötigten Betrag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a new expense is manually entered from the selected account and would overdraw its category, Actuali automatically funds only the amount needed to cover that expense."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando un nuevo gasto introducido manualmente desde la cuenta seleccionada sobregira su categoría, Actuali financia automáticamente solo el importe necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu'une nouvelle dépense saisie manuellement depuis le compte sélectionné dépasserait la catégorie, Actuali finance automatiquement uniquement le montant nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando una nuova spesa inserita manualmente dal conto selezionato supera la categoria, Actuali finanzia automaticamente solo l'importo necessario."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer een nieuwe uitgave vanaf de geselecteerde rekening de categorie overschrijdt, financiert Actuali automatisch alleen het benodigde bedrag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando uma nova despesa é inserida manualmente pela conta selecionada e ultrapassa a categoria, o Actuali financia automaticamente apenas o valor necessário."
          }
        }
      }
    },
    "When enabled, scheduled transactions that are due are posted automatically when the app opens — the same as opening the Actual web app. Transactions are created on your server." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden fällige geplante Transaktionen beim Öffnen der App automatisch gebucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, scheduled transactions that are due are posted automatically when the app opens — the same as opening the Actual web app. Transactions are created on your server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al activarla, las transacciones programadas vencidas se publican automáticamente al abrir la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, les transactions planifiées échues sont publiées automatiquement à l’ouverture de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando attiva, le transazioni programmate scadute vengono pubblicate automaticamente all’apertura dell’app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer ingeschakeld worden vervallen geplande transacties automatisch geplaatst bij het openen van de app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativada, as transações agendadas vencidas são publicadas automaticamente ao abrir o app."
          }
        }
      }
    },
    "Within budget" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innerhalb des Budgets"
          }
        },
        "en" : {
          "stringUnit" : {
