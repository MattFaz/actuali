    "Symbol Only shows amounts with just the currency symbol — $ instead of NZ$.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbol Only shows amounts with just the currency symbol — $ instead of NZ$."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbole uniquement affiche les montants avec seulement le symbole monétaire — $ au lieu de NZ$."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo símbolo muestra los importes solo con el símbolo de moneda: $ en lugar de NZ$."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente símbolo mostra os valores apenas com o símbolo da moeda — $ em vez de NZ$."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Symbol zeigt Beträge nur mit dem Währungssymbol – $ statt NZ$."
          }
        },
        "it": {
