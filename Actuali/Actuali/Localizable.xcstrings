    "This permanently deletes “%@” from your Actual server for every device that uses it, along with this device's copy and its local backups. This cannot be undone.\n\nType the budget's name to confirm." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht „%@“ dauerhaft vom Actual-Server.\n\nGib den Namen zur Bestätigung ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes “%@” from your Actual server for every device that uses it, along with this device's copy and its local backups. This cannot be undone.\n\nType the budget's name to confirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente « %@ » de tu servidor Actual.\n\nEscribe el nombre para confirmar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime définitivement « %@ » de votre serveur Actual. Cette action est irréversible.\n\nSaisissez le nom du budget pour confirmer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente «%@» dal server Actual.\n\nInserisci il nome per confermare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert “%@” definitief van je Actual-server.\n\nTyp de naam om te bevestigen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui permanentemente “%@” do servidor Actual.\n\nDigite o nome para confirmar."
          }
        }
      }
    },
