    "At the end of the month, sources give up their leftover balance and sinks receive it, split by weight. Pools scope the exchange to their members." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Monatsende geben Quellen ihren verbleibenden Saldo ab, und Senken erhalten ihn, aufgeteilt nach Gewichtung. Pools beschränken den Austausch auf ihre Mitglieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the end of the month, sources give up their leftover balance and sinks receive it, split by weight. Pools scope the exchange to their members."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A final de mes, las fuentes ceden su saldo sobrante y los destinos lo reciben, repartido según su peso. Los grupos limitan el intercambio a sus miembros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À la fin du mois, les sources cèdent leur solde restant et les puits le reçoivent, réparti selon leur poids. Les pools limitent l'échange à leurs membres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla fine del mese, le fonti cedono il saldo residuo e i pozzi lo ricevono, ripartito in base al peso. I pool limitano lo scambio ai propri membri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aan het einde van de maand geven bronnen hun resterende saldo af en ontvangen bestemmingen dit, verdeeld naar gewicht. Pools beperken de uitwisseling tot hun leden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No fim do mês, as fontes cedem seu saldo restante e os destinos o recebem, dividido por peso. Os pools limitam a troca aos seus membros."
          }
        }
      }
    },
    "Automatically Add Transaction" : {
      "localizations" : {
