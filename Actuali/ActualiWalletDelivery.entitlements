<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Wallet delivery extension entitlements. The app group must match
  Actuali.entitlements (WalletDelivery state is shared through it).

  FinanceKit is a managed entitlement granted per bundle ID: device builds of
  this extension need a provisioning profile that carries it for
  com.mfazz.ActualiOS.WalletDelivery. Simulator builds and CI are unaffected.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.mfazz.ActualiOS</string>
	</array>
	<key>com.apple.developer.financekit</key>
	<array>
		<string>financial-data</string>
	</array>
</dict>
</plist>
