---
interface Props {
  /** Pixel size of the square mark. */
  size?: number;
  /** Render the "Actuali" wordmark next to the mark. */
  withWordmark?: boolean;
  class?: string;
}
const { size = 28, withWordmark = true, class: className = "" } = Astro.props;
---

<span class={`inline-flex items-center gap-2 ${className}`}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 1024 1024"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="shrink-0"
  >
    <defs>
      <linearGradient id="actuali-mark" x1="0%" y1="0%" x2="3%" y2="100%">
        <stop offset="0%" stop-color="#7534FF"></stop>
        <stop offset="18%" stop-color="#6D2FF8"></stop>
        <stop offset="55%" stop-color="#5120D9"></stop>
        <stop offset="100%" stop-color="#3514B4"></stop>
      </linearGradient>
    </defs>
    <rect width="1024" height="1024" rx="230" fill="url(#actuali-mark)"></rect>
    <g transform="translate(105.6 137.2) scale(1.0599)">
